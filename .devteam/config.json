{
  "pack": ".devteam/pack",
  "agent": {
    "runtime": "opencode",
    "command": "opencode",
    "args": [
      "run",
      "--format",
      "json",
      "--dir",
      "{dir}",
      "{prompt}"
    ],
    "discussArgs": [
      "--agent",
      "plan",
      "--prompt",
      "{prompt}"
    ],
    "model": "opencode-go/deepseek-v4.1-flash",
    "timeoutSeconds": 900,
    "stallSeconds": 900,
    "roles": {}
  },
  "limits": {
    "maxRevisionRounds": 2,
    "maxDefineRounds": 2,
    "maxArtifactAttempts": 2,
    "budgetUsd": 10,
    "parallelChallengers": true,
    "baselineChecks": true,
    "tidyStrayFiles": true,
    "quickCheckSeconds": 30,
    "analystQuestionBudget": 8,
    "analystQuestionCap": 12,
    "maxAssumedTopics": 3,
    "strictRequirements": true,
    "maxRequirements": 25,
    "requirementsSignOff": true,
    "maxSignOffChanges": 3,
    "stageMinutes": 45
  }
}